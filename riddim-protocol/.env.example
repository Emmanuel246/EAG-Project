# --- Offchain: Supabase (rights mirror / index) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Media: Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Wallet auth (RainbowKit / WalletConnect) ---
# Free project id from https://cloud.walletconnect.com. Enables WalletConnect
# and mobile wallets (the full "wide range"). Injected browser wallets
# (MetaMask, Rainbow, Coinbase extension, …) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Onchain: RiddimRegistry contract ---
# Leave CONTRACT_ADDRESS empty to run in "offchain mode" (Supabase only, no chain
# reads/writes — the UI shows a banner instead of crashing). Set it to the
# deployed address to enable onchain reads and browser-wallet writes.
NEXT_PUBLIC_CONTRACT_ADDRESS=
# HSK Testnet is chain 133 (NOT 177 — that is HashKey mainnet). RPC has no /rpc suffix.
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_HSK_RPC_URL=https://testnet.hsk.xyz

# --- Contract deployment (contracts/ Hardhat project only; never commit real keys) ---
# Used by `npx hardhat run scripts/deploy.js --network hskTestnet`
DEPLOYER_PRIVATE_KEY=your-deployer-private-key
